generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Photo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  imageUrl  String
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  image     String?
  createdAt DateTime @default(now())
}

model Banner {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  tag      String?
  title    String
  slogan   String?
  desc     String?
  link     String
  name     String
  image    String
  createAt DateTime @default(now())
}

model About {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tag       String
  title     String
  desc      String
  Lanuage   String
  createdAt DateTime @default(now())
}

model Project {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  image      String
  title      String
  desc       String
  technology String
  git_link   String
  live_link  String
  createdAt  DateTime @default(now())
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  link      String
  createdAt DateTime @default(now())
}

model Task {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  category     String
  priority     String   @default("Medium")
  status       String   @default("To Do")
  startDate    String
  deadline     String
  remindDays   Int[]    @default([])
  reminderTime String   @default("08:00")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TaskReminderDelivery {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId             String   @db.ObjectId
  scheduledDate      String
  reminderDaysBefore Int
  sentAt             DateTime?

  @@unique([taskId, scheduledDate, reminderDaysBefore])
  @@index([scheduledDate])
}
