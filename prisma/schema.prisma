
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Photo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  imageUrl  String
  createdAt DateTime @default(now())
}
 
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  image     String? 
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tag       String?
  title     String
  slogan    String?
  desc      String?
  link      String
  name      String
  image     String 
  createAt  DateTime @default(now())
}

model About {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tag       String
  title     String
  desc      String
  Lanuage   String
  createdAt DateTime @default(now())
}