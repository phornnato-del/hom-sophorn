generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Photo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  imageUrl  String
  createdAt DateTime @default(now())
}

model User {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  email               String    @unique
  name                String?
  password            String
  role                String    @default("admin")
  image               String?
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  attempts            Int       @default(0)
  attemptBlockedUntil DateTime?
  createdAt           DateTime  @default(now())
}

model AdminLoginAttempt {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  ipAddress         String
  attemptedUsername String?
  country           String?
  region            String?
  city              String?
  timezone          String?
  latitude          Float?
  longitude         Float?
  locationSource    String?
  userAgent         String?
  requestId         String?
  stage             String
  outcome           String
  statusCode        Int
  createdAt         DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([attemptedUsername, createdAt])
  @@index([outcome, createdAt])
}

model Banner {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  tag      String?
  title    String
  slogan   String?
  desc     String?
  link     String
  name     String
  image    String
  createAt DateTime @default(now())
}

model About {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tag       String
  title     String
  desc      String
  Lanuage   String
  createdAt DateTime @default(now())
}

model Project {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  image      String
  title      String
  desc       String
  technology String
  git_link   String
  live_link  String
  createdAt  DateTime @default(now())
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  link      String
  createdAt DateTime @default(now())
}

model Task {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  category     String
  priority     String   @default("Medium")
  status       String   @default("To Do")
  startDate    String
  deadline     String
  remindDays   Int[]    @default([])
  reminderTime String   @default("08:00")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TaskReminderDelivery {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  taskId             String    @db.ObjectId
  scheduledDate      String
  reminderDaysBefore Int
  sentAt             DateTime?

  @@unique([taskId, scheduledDate])
  @@index([scheduledDate])
}
